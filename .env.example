ASSISTANT_ENABLED=true
LLM_PRIMARY_PROVIDER=gemini
LLM_PRIMARY_MODEL=gemini-1.5-flash
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_LOCAL_URL=http://localhost:11434
LLM_API_KEY_PRIMARY=
LLM_API_KEY_FALLBACK=
LLM_TIMEOUT_MS=6000
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_BUCKET=./private-storage
ASSISTANT_MAX_MESSAGE_CHARS=4000
ASSISTANT_RETRIEVAL_TOP_K=20
ASSISTANT_MAX_CONTEXT_CHUNKS=8
ASSISTANT_MIN_EVIDENCE_SCORE=0.018
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
ASSISTANT_DAILY_REQUEST_BUDGET=1500
ASSISTANT_SUPPORT_URL=/support
